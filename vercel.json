{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/run.js": {
      "maxDuration": 60,
      "includeFiles": "{api/**,scripts/**,manifests/**,commands/**,skills/**,agents/**,mclain-app/**,docs/COMMAND-REGISTRY.json,docs/zh-CN/**,.claude-plugin/**,AGENTS.md,README.md,README.zh-CN.md,package.json,vercel.json}"
    },
    "api/status.js": {
      "includeFiles": "{manifests/**,commands/**,skills/**,package.json}"
    },
    "api/profile.js": {
      "includeFiles": "manifests/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/mclain-app/public/index.html"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/mclain-app/public/manifest.webmanifest"
    },
    {
      "source": "/styles.css",
      "destination": "/mclain-app/public/styles.css"
    },
    {
      "source": "/core.js",
      "destination": "/mclain-app/public/core.js"
    },
    {
      "source": "/ops-config.js",
      "destination": "/mclain-app/public/ops-config.js"
    },
    {
      "source": "/app.js",
      "destination": "/mclain-app/public/app.js"
    },
    {
      "source": "/sw.js",
      "destination": "/mclain-app/public/sw.js"
    },
    {
      "source": "/icon.svg",
      "destination": "/mclain-app/public/icon.svg"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
